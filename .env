# UNISWAP_SYMBOL_POOL_MAP=...

PAYOS_CLIENT_ID=48d41987-5b0d-44b1-bd92-1bdf38bff16a
PAYOS_API_KEY=071a27e9-afe3-4a18-82b3-152d0b9f39d6
