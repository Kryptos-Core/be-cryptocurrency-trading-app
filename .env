# DEV ONLY: Allow blockchain wallet link bypass with test signature prefix.
# Conditions required together:
# - NODE_ENV=development
# - BLOCKCHAIN_ALLOW_TEST_SIGNATURE=true
# Signature format: TEST_SIG::<any-non-empty-payload>
BLOCKCHAIN_ALLOW_TEST_SIGNATURE=false

# WalletConnect / Reown — mô tả đầy đủ: docs/WALLETCONNECT.md
# Project ID: https://cloud.reown.com/ (cùng giá trị với FE .env)
WALLETCONNECT_PROJECT_ID=5caba46b4ca135d5433369c8d23b6d85
WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.com
# Secret để verify HMAC signature từ WC relay webhook (irn_watchRegister)
# Để trống nếu chưa cấu hình relay webhook
WALLETCONNECT_WEBHOOK_SECRET=

# Hybrid withdrawal controls (amount <= auto max => auto-send, else manual review)
BLOCKCHAIN_WITHDRAW_AUTO_MAX=0.5
# Optional per-chain overrides
BLOCKCHAIN_WITHDRAW_AUTO_MAX_ETH_SEPOLIA=0.5
BLOCKCHAIN_WITHDRAW_AUTO_MAX_SOLANA_DEVNET=1
BLOCKCHAIN_WITHDRAW_AUTO_MAX_TRON_NILE=100
BLOCKCHAIN_WITHDRAW_AUTO_MAX_TRON_SHASTA=100

# Currency symbol mapping used by withdrawal/deposit settlement to wallet ledger
BLOCKCHAIN_WITHDRAW_ETH_SYMBOL=ETH
BLOCKCHAIN_WITHDRAW_SOL_SYMBOL=SOL
BLOCKCHAIN_WITHDRAW_TRON_SYMBOL=TRX

# Platform Cash Currency — tất cả deposit on-chain (TRX/ETH/SOL) sẽ được quy đổi sang
# currency này và credit vào ví tiền ảo của user (mặc định: USDT)
# Dùng chung với PAYOS_DEPOSIT_CURRENCY_SYMBOL
PLATFORM_CASH_CURRENCY_SYMBOL=USDT

# Fallback tỷ giá quy đổi khi Binance API không khả dụng (testnet/offline)
# 1 TRX = X USDT
BLOCKCHAIN_DEPOSIT_TRX_TO_USDT_RATE=0.12
# 1 ETH = X USDT
BLOCKCHAIN_DEPOSIT_ETH_TO_USDT_RATE=3500
# 1 SOL = X USDT
BLOCKCHAIN_DEPOSIT_SOL_TO_USDT_RATE=180

