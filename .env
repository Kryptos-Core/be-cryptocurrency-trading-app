# Redirect URLs after checkout success/cancel
# Use frontend route, app deep link, or public callback URL depending on platform
PAYOS_RETURN_URL=http://127.0.0.1:3000/success
PAYOS_CANCEL_URL=http://127.0.0.1:3000/cancel
# Wallet currency symbol to credit after PayOS payment is confirmed
PAYOS_DEPOSIT_CURRENCY_SYMBOL=USDT
# Fiat symbol that PayOS amount is denominated in
PAYOS_FIAT_SYMBOL=VND
# Conversion rate from 1 fiat unit -> quote currency unit (example: 1 VND -> 0.00004 USDT)
PAYOS_FIAT_TO_QUOTE_RATE=0.00004
# Optional conversion spread in basis points deducted from gross quote amount (100 bps = 1%)
PAYOS_FX_SPREAD_BPS=0

# Fiat (bank) withdrawal — USDT to VN bank (manual transfer by admin)
# Min/max per request (platform cash / USDT). Daily limit 0 = disabled.
FIAT_WITHDRAW_MIN=10
FIAT_WITHDRAW_MAX=100000
FIAT_WITHDRAW_DAILY_LIMIT_USER=0

