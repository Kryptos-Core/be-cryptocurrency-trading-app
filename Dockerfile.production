# Multi-stage Dockerfile for production
# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first (layer caching)
COPY package*.json ./
RUN npm install --ignore-scripts

# Copy source code
COPY tsconfig*.json ./
COPY nest-cli*.json ./
COPY src ./src

# Build application
RUN npm run build

# Prune dev dependencies
RUN npm prune --production

# Stage 2: Production
FROM node:20-alpine AS production

# Security: create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001 -G nodejs

WORKDIR /app

# Copy built artifacts from builder
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/package*.json ./
COPY --from=builder --chown=nestjs:nodejs /app/tsconfig*.json ./
# Copy source files needed by runtime helper scripts (required for db:migrate:prod and db:seed:prod)
COPY --from=builder --chown=nestjs:nodejs /app/src ./src

# Compile TypeScript files used at runtime outside webpack bundle without replacing bundled app dist
RUN npm install --no-save typescript && \
    npx tsc --project tsconfig.json --outDir /tmp/compiled && \
    rm -rf src && \
    cp -R /tmp/compiled ./src && \
    cp -R /tmp/compiled/seed dist/seed && \
    cp -R /tmp/compiled/config dist/config && \
    cp -R /tmp/compiled/entities dist/entities && \
    cp -R /tmp/compiled/migrations dist/migrations && \
    mkdir -p dist/modules/blockchain/entities && \
    cp -R /tmp/compiled/modules/blockchain/entities/* dist/modules/blockchain/entities/ && \
    mkdir -p dist/modules/treasury/workers && \
    cp -R /tmp/compiled/modules/treasury/workers/* dist/modules/treasury/workers/ && \
    npm uninstall typescript && \
    rm -rf /tmp/compiled

# Set production environment
ENV NODE_ENV=production
ENV NPM_CONFIG_PRODUCTION=true

# Switch to non-root user
USER nestjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Start application
CMD ["node", "dist/main"]
