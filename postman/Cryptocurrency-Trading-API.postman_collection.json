{
	"info": {
		"_postman_id": "cryptocurrency-trading-api",
		"name": "Cryptocurrency Trading API - Currencies",
		"description": "Postman collection để test API quản lý danh sách tiền ảo (Currencies Module)\n\n**Các tính năng:**\n- CRUD operations cho currencies\n- Pagination và filtering\n- Redis caching\n- JWT Authentication\n\n**Cách sử dụng:**\n1. Import collection này vào Postman\n2. Tạo environment với biến:\n   - `base_url`: http://localhost:3000\n   - `access_token`: (sẽ được set tự động sau khi login)\n3. Chạy request \"Auth - Login\" để lấy token\n4. Các request khác sẽ tự động sử dụng token",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data && response.data.access_token) {",
									"        pm.environment.set('access_token', response.data.access_token);",
									"        console.log('Access token saved to environment');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập để lấy JWT access token. Token sẽ được tự động lưu vào environment variable `access_token`."
					},
					"response": []
				}
			],
			"description": "Authentication endpoints"
		},
		{
			"name": "Currencies",
			"item": [
				{
					"name": "Get All Currencies",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{access_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/currencies?page=1&limit=10&includeInactive=false",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"currencies"
							],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number (default: 1)"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Items per page (default: 10)"
								},
								{
									"key": "includeInactive",
									"value": "false",
									"description": "Include inactive currencies (default: false)"
								}
							]
						},
						"description": "Lấy danh sách tất cả currencies với pagination. Có thể filter để bao gồm hoặc loại trừ inactive currencies."
					},
					"response": []
				},
				{
					"name": "Get All Currencies - With Inactive",
					"request": {
						"auth": {
							"type": "bearer",
