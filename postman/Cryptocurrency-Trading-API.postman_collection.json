							"raw": "{{base_url}}/currencies?page=1&limit=10&includeInactive=true",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"currencies"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "includeInactive",
									"value": "true"
								}
							]
						},
						"description": "Lấy danh sách currencies bao gồm cả inactive currencies."
					},
					"response": []
