								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/currencies/symbol/:symbol",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"currencies",
								"symbol",
								":symbol"
							],
							"variable": [
								{
									"key": "symbol",
									"value": "BTC",
									"description": "Currency symbol (e.g., BTC, ETH, USDT)"
								}
							]
						},
						"description": "Lấy thông tin currency theo symbol (ví dụ: BTC, ETH, USDT)."
					},
					"response": []
				},
				{
					"name": "Create Currency",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{access_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"symbol\": \"BTC\",\n  \"name\": \"Bitcoin\",\n  \"precisionScale\": 8,\n  \"minWithdraw\": \"0.001\",\n  \"isTradable\": true,\n  \"isActive\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/currencies",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"currencies"
							]
						},
						"description": "Tạo currency mới. \n\n**Required fields:**\n- `symbol`: Currency symbol (uppercase, alphanumeric, 2-16 chars)\n- `name`: Currency full name (1-64 chars)\n\n**Optional fields:**\n- `precisionScale`: Decimal precision (0-18, default: 8)\n- `minWithdraw`: Minimum withdrawal amount (default: \"0\")\n- `isTradable`: Is tradable (default: true)\n- `isActive`: Is active (default: true)\n\n**Validation:**\n- Symbol must be unique\n- Symbol must match pattern: ^[A-Z0-9]+$"
					},
					"response": []
				},
				{
					"name": "Create Currency - Minimal",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{access_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"symbol\": \"ETH\",\n  \"name\": \"Ethereum\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/currencies",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"currencies"
							]
						},
						"description": "Tạo currency với chỉ các field bắt buộc. Các field optional sẽ dùng giá trị default."
					},
					"response": []
				},
				{
					"name": "Update Currency",
					"request": {
						"auth": {
							"type": "bearer",
