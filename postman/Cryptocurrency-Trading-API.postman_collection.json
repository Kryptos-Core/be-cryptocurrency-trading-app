									"value": "{{access_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Bitcoin Updated\",\n  \"isActive\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/currencies/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"currencies",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "1",
									"description": "Currency ID to update"
								}
							]
						},
						"description": "Cập nhật thông tin currency. Tất cả các fields đều optional.\n\n**Có thể update:**\n- `symbol`: Currency symbol (không nên thay đổi)\n- `name`: Currency name\n- `precisionScale`: Decimal precision (0-18)\n- `minWithdraw`: Minimum withdrawal amount\n- `isTradable`: Is tradable\n- `isActive`: Is active"
					},
					"response": []
				},
				{
					"name": "Update Currency - Full",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
