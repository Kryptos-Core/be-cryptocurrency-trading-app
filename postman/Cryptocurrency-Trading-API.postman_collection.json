							"mode": "raw",
							"raw": "{\n  \"symbol\": \"BTC\",\n  \"name\": \"Bitcoin\",\n  \"precisionScale\": 8,\n  \"minWithdraw\": \"0.0001\",\n  \"isTradable\": true,\n  \"isActive\": true\n}"
						},
