# Binance Testnet
TRADING_ENVIRONMENT=testnet
EXCHANGE_MODE=binance
BINANCE_TESTNET_ENABLED=true
BINANCE_TESTNET_API_KEY=ky0yxPNEnwj8nOViEvFdzmSfiGU13jIvFnYfnl6uDJaui8zidsBVuodQ2OOgwmN6
BINANCE_TESTNET_API_SECRET=0ZPwyX9mP8Utoj3buuzpLMqEZsKgvEaVdtuA6ABdCbSQEsJU6IR2l9MkTwMRSS0E
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision

# Wallet encryption (treasury / payment config payloads) — không quản lý qua tab Platform
WALLET_ENCRYPTION_KEY=ee85d61cb8d9b9e1943c5d3d0397f84b0b1cf5068328057f8b739df3c97a1948

# WalletConnect / Reown — mô tả đầy đủ: docs/WALLETCONNECT.md
# Các key dưới đây phải khớp whitelist src/config/env.validation.ts (EnvironmentVariables + envVarKeys).
# Project ID: https://cloud.reown.com/ (cùng giá trị với FE .env)
WALLETCONNECT_PROJECT_ID=5caba46b4ca135d5433369c8d23b6d85
# Tùy chọn: nếu FE chỉ đặt REOWN_PROJECT_ID, có thể copy cùng giá trị vào đây (BE đọc cả hai)
REOWN_PROJECT_ID=5caba46b4ca135d5433369c8d23b6d85
WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.com
# Secret để verify HMAC signature từ WC relay webhook (irn_watchRegister)
# Để trống nếu chưa cấu hình relay webhook
WALLETCONNECT_WEBHOOK_SECRET=

# On-chain: production = mainnets in resolver; sandbox = testnets.
# Khi ONCHAIN_OPERATOR_MODE=sandbox mà không set 4 URL dưới, BE gán mặc định public RPC (cùng logic app.config).
# Ghi đè nếu bạn dùng endpoint riêng. Khác với PayOS sandbox. Chi tiết: docs/ENV_CONFIG_USAGE.md
# ONCHAIN_OPERATOR_MODE=production
ONCHAIN_OPERATOR_MODE=sandbox
# TRON_NILE_FULL_HOST=https://nile.trongrid.io
# TRON_SHASTA_FULL_HOST=
# SOLANA_DEVNET_URL=https://api.devnet.solana.com
# ETH_SEPOLIA_RPC_URL=https://rpc.sepolia.org
# ETH_SEPOLIA_CHAIN_ID=11155111
# BSC_CHAPEL_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# BSC_CHAPEL_CHAIN_ID=97

# --- PayOS (.env fallback) ---
# DB có cấu hình PayOS active thì ưu tiên DB; .env chỉ dùng khi chưa có (xem docs/ENV_CONFIG_USAGE.md).
# PayOS sandbox vs production = tài khoản/dashboard PayOS; KHÔNG trùng ONCHAIN_OPERATOR_MODE (on-chain).
#
# (1) Fallback credentials — placeholder, không commit secret thật
PAYOS_CLIENT_ID=48d41987-5b0d-44b1-bd92-1bdf38bff16a
PAYOS_API_KEY=071a27e9-afe3-4a18-82b3-152d0b9f39d6
PAYOS_CHECKSUM_KEY=51fa3cf2dd3447982a6852fdc6532845c6a3d1fcc2fa381db25975991204dcde
# (2) Redirect sau checkout (web route, deep link, hoặc callback công khai tùy nền tảng)
PAYOS_RETURN_URL=http://127.0.0.1:3000/success
PAYOS_CANCEL_URL=http://127.0.0.1:3000/cancel
# (3) FX / ký hiệu: symbol ví được cộng sau khi thanh toán PayOS được xác nhận
PAYOS_DEPOSIT_CURRENCY_SYMBOL=USDT
PAYOS_FIAT_SYMBOL=VND
PAYOS_FIAT_TO_QUOTE_RATE=0.00004
PAYOS_FX_SPREAD_BPS=0

