NODE_ENV=production
PORT=3000

# ─── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL source of truth
CORE_DB_SOURCE=postgres
CORE_DB_TYPE=postgres
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=5432
CORE_DB_USERNAME=crypto_user
CORE_DB_PASSWORD=CHANGE_ME
CORE_DB_NAME=crypto_trading_platform

# TimescaleDB (optional — enable MARKET_TS_ENABLED=true when TimescaleDB is available)
MARKET_TS_ENABLED=false
MARKET_TS_DRIVER=postgres
MARKET_TS_HOST=127.0.0.1
MARKET_TS_PORT=5433
MARKET_TS_USERNAME=crypto_user
MARKET_TS_PASSWORD=CHANGE_ME
MARKET_TS_DB=crypto_trading_platform
MARKET_TS_TIMESCALE_ENABLED=false
MARKET_TS_RETENTION_ENABLED=false
MARKET_TS_RETENTION_DAYS=30
MARKET_TS_COMPRESSION_ENABLED=false
MARKET_TS_COMPRESS_AFTER_DAYS=7

# Market read source: postgres | redis | timescale
MARKET_READ_SOURCE=postgres

# ─── Analytics / ClickHouse ───────────────────────────────────────────────────
# ANALYTICS_ENABLED=true → enables ClickHouse audit sink (Phase 5c)
# Start ClickHouse with: docker compose --profile clickhouse up
ANALYTICS_ENABLED=false
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default
CLICKHOUSE_PORT=8123
CLICKHOUSE_TCP_PORT=9000

# ─── Event Outbox ─────────────────────────────────────────────────────────────
EVENT_OUTBOX_ENABLED=true
EVENT_SCHEMA_FORMAT=json
# Driver: noop | kafka | redis | bullmq — set to kafka for production
EVENT_PUBLISHER_DRIVER=noop
EVENT_OUTBOX_MAX_ATTEMPTS=5
EVENT_OUTBOX_RETRY_BASE_MS=1000

# ─── Kafka ───────────────────────────────────────────────────────────────────
# Silence KafkaJS v2.0 partitioner change warning
KAFKAJS_NO_PARTITIONER_WARNING=1
# Leave KAFKA_BROKERS empty when EVENT_PUBLISHER_DRIVER=noop
# When EVENT_PUBLISHER_DRIVER=kafka → set KAFKA_BROKERS and KAFKA_TOPIC_PREFIX
# Start Kafka with: docker compose --profile kafka up
KAFKA_BROKERS=
KAFKA_CLIENT_ID=crypto-trading-backend-outbox
KAFKA_TOPIC_PREFIX=
KAFKA_PORT=9092

# Kafka consumer (Phase 5d): enable only when Kafka brokers are available
KAFKA_CONSUMERS_ENABLED=false
KAFKA_CONSUMER_GROUP_PREFIX=crypto-trading

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a strong random 64-char hex secret — never use default values
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_EXPIRATION=24h

# ─── Matching Engine ─────────────────────────────────────────────────────────
# Type: ts | go — all matching config is also manageable via /system-configs/runtime (DB)
# MATCHING_ENGINE=ts
# TICKER_SOURCE=nestjs
# PUBLIC_WS_SOURCE=nestjs
# MATCHING_GO_CANARY_PAIRS=
# GO_AGGREGATOR_TICKER_CHANNEL=trading:external:ticker
# GO_AGGREGATOR_OHLC_CHANNEL=trading:external:ohlc
# MATCHING_SHADOW_MONITOR_PAIRS=
# MATCHING_SHADOW_ALERT_MIN_MATCH_RATE_PERCENT=99.9
# MATCHING_SHADOW_ALERT_MAX_UNMATCHED_RUNS=0
# GO_ROLLOUT_WINDOW_HOURS=24
# GO_ROLLOUT_MAX_PUBLIC_WS_DRIFT_PAIRS=0
# GO_ROLLOUT_MIN_PUBLIC_WS_COMPARED_PAIRS=1
# GO_ROLLOUT_ROLLBACK_DRILL_MAX_AGE_HOURS=72

# ─── Exchange ─────────────────────────────────────────────────────────────────
# Set real Binance Mainnet credentials for production
TRADING_ENVIRONMENT=mainnet
EXCHANGE_MODE=binance
BINANCE_TESTNET_ENABLED=false
BINANCE_MAINNET_API_KEY=CHANGE_ME
BINANCE_MAINNET_API_SECRET=CHANGE_ME
BINANCE_MAINNET_BASE_URL=https://fapi.binance.com

# ─── On-chain ─────────────────────────────────────────────────────────────────
# Mode: production (mainnets) — sandbox uses testnets
ONCHAIN_OPERATOR_MODE=production
TRON_GRID_API_KEY=CHANGE_ME

# ─── EVM RPC URLs ──────────────────────────────────────────────────────────────────
# Managed in DB via /system-configs/runtime/tech (requires FINANCE_MANAGER role).
# Fallback values are in EVM_CHAIN_DEFINITIONS (hardcoded defaults).
# Uncomment below to override DB values in this environment.
# ETH_MAINNET_RPC_URL=https://cloudflare-eth.com
# BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org
# BASE_MAINNET_RPC_URL=https://mainnet.base.org
# ARBITRUM_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc
# OPTIMISM_MAINNET_RPC_URL=https://mainnet.optimism.io
# POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com
# AVALANCHE_MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# GNOSIS_MAINNET_RPC_URL=https://rpc.gnosischain.com
# LINEA_MAINNET_RPC_URL=https://rpc.linea.build
# FANTOM_MAINNET_RPC_URL=https://rpc.ftm.tools

# ─── Deposit Watcher ──────────────────────────────────────────────────────────
# Chains to scan for EVM USDT deposits. FANTOM chains excluded (no working public RPC).
# EVM wallets created via POST /treasury/wallets and set default via PATCH /managed-wallets/:id/set-deposit-default
DEPOSIT_WATCHER_CHAINS=GNOSIS_CHIADO,AVALANCHE_FUJI,BASE_SEPOLIA,ARBITRUM_MAINNET,GNOSIS_MAINNET,POLYGON_MAINNET,ETH_MAINNET,LINEA_MAINNET,OPTIMISM_SEPOLIA,BASE_MAINNET,LINEA_SEPOLIA,OPTIMISM_MAINNET,ETH_SEPOLIA,BSC_MAINNET,POLYGON_AMOY,BSC_CHAPEL,ARBITRUM_SEPOLIA,AVALANCHE_MAINNET

# ─── Wallet encryption (treasury / payment config payloads) ───────────────────
# IMPORTANT: Replace with a strong 32-byte hex key — never use default values
WALLET_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX

# ─── WalletConnect / Reown ───────────────────────────────────────────────────
WALLETCONNECT_PROJECT_ID=CHANGE_ME
REOWN_PROJECT_ID=CHANGE_ME
WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.com
WALLETCONNECT_WEBHOOK_SECRET=CHANGE_ME

# ─── PayOS ───────────────────────────────────────────────────────────────────
# DB config takes priority when PayOS is active in the database
PAYOS_CLIENT_ID=CHANGE_ME
PAYOS_API_KEY=CHANGE_ME
PAYOS_CHECKSUM_KEY=CHANGE_ME
PAYOS_RETURN_URL=https://yourdomain.com/success
PAYOS_CANCEL_URL=https://yourdomain.com/cancel
PAYOS_DEPOSIT_CURRENCY_SYMBOL=USDT
PAYOS_FIAT_SYMBOL=VND
PAYOS_FIAT_TO_QUOTE_RATE=0.00004
PAYOS_FX_SPREAD_BPS=0

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_AVATAR_FOLDER=avatars

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=Crypto Trading <noreply@yourdomain.com>

# ─── Firebase ────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
