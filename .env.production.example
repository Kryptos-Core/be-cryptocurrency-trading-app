NODE_ENV=production
PORT=3000

# ─── Database ───────────────────────────────────────────────────────────────────
CORE_DB_SOURCE=postgres
CORE_DB_TYPE=postgres
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=5432
CORE_DB_USERNAME=crypto_user
CORE_DB_PASSWORD=CHANGE_ME
CORE_DB_NAME=crypto_trading_platform

# Market read source: postgres | redis | timescale
MARKET_READ_SOURCE=postgres

# ─── Event Outbox ─────────────────────────────────────────────────────────────
EVENT_OUTBOX_ENABLED=true
EVENT_SCHEMA_FORMAT=json
# Driver: noop | kafka | redis | bullmq
EVENT_PUBLISHER_DRIVER=noop
EVENT_OUTBOX_MAX_ATTEMPTS=5
EVENT_OUTBOX_RETRY_BASE_MS=1000

# ─── Kafka ───────────────────────────────────────────────────────────────────
# Uncomment and set EVENT_PUBLISHER_DRIVER=kafka when Kafka container is running
# docker compose -f docker-compose.infrastructure.yml --profile kafka up -d
# KAFKAJS_NO_PARTITIONER_WARNING=1
# KAFKA_BROKERS=localhost:29092
# KAFKA_CLIENT_ID=crypto-trading-backend-outbox
# KAFKA_TOPIC_PREFIX=crypto-trading
# KAFKA_DLQ_TOPIC_ENABLED=true
# KAFKA_CONSUMERS_ENABLED=true
# KAFKA_CONSUMER_GROUP_PREFIX=crypto-trading

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a strong random 64-char hex secret — never use default values
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_EXPIRATION=24h

# ─── Matching Engine ─────────────────────────────────────────────────────────
# Type: ts | go — all matching config is also manageable via /system-configs/runtime (DB)
# MATCHING_ENGINE=ts
# TICKER_SOURCE=nestjs
# PUBLIC_WS_SOURCE=nestjs
# MATCHING_GO_CANARY_PAIRS=
# GO_AGGREGATOR_TICKER_CHANNEL=trading:external:ticker
# GO_AGGREGATOR_OHLC_CHANNEL=trading:external:ohlc
# MATCHING_SHADOW_MONITOR_PAIRS=
# MATCHING_SHADOW_ALERT_MIN_MATCH_RATE_PERCENT=99.9
# MATCHING_SHADOW_ALERT_MAX_UNMATCHED_RUNS=0
# GO_ROLLOUT_WINDOW_HOURS=24
# GO_ROLLOUT_MAX_PUBLIC_WS_DRIFT_PAIRS=0
# GO_ROLLOUT_MIN_PUBLIC_WS_COMPARED_PAIRS=1
# GO_ROLLOUT_ROLLBACK_DRILL_MAX_AGE_HOURS=72

# ─── Exchange ─────────────────────────────────────────────────────────────────
# Set real Binance Mainnet credentials for production
TRADING_ENVIRONMENT=mainnet
EXCHANGE_MODE=binance
BINANCE_TESTNET_ENABLED=false
BINANCE_MAINNET_API_KEY=CHANGE_ME
BINANCE_MAINNET_API_SECRET=CHANGE_ME
BINANCE_MAINNET_BASE_URL=https://fapi.binance.com

# ─── On-chain ─────────────────────────────────────────────────────────────────
ONCHAIN_OPERATOR_MODE=production
TRON_GRID_API_KEY=a87e9482-111f-4a80-b789-f77ebdac90b5

# ─── Wallet encryption ────────────────────────────────────────────────────────
# IMPORTANT: Replace with a strong 32-byte hex key — never use default values
WALLET_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX

# ─── PayOS ───────────────────────────────────────────────────────────────────
# DB config takes priority when PayOS is active in the database
PAYOS_CLIENT_ID=CHANGE_ME
PAYOS_API_KEY=CHANGE_ME
PAYOS_CHECKSUM_KEY=CHANGE_ME
PAYOS_RETURN_URL=https://yourdomain.com/success
PAYOS_CANCEL_URL=https://yourdomain.com/cancel
PAYOS_DEPOSIT_CURRENCY_SYMBOL=USDT
PAYOS_FIAT_SYMBOL=VND
PAYOS_FIAT_TO_QUOTE_RATE=0.00004
PAYOS_FX_SPREAD_BPS=0

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=Crypto Trading <noreply@yourdomain.com>

# ─── Firebase ────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
