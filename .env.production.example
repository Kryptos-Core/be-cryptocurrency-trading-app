# ============================================================
# Production Environment Configuration
# ============================================================
# IMPORTANT: Copy this file to .env.production on the server
# and fill in all CHANGE_ME values with real credentials.
# NEVER commit .env.production to version control.
# ============================================================

NODE_ENV=production
PORT=3000
APP_PORT=3000

# ─── Database ───────────────────────────────────────────────────────────────────
CORE_DB_SOURCE=postgres
CORE_DB_TYPE=postgres
CORE_DB_HOST=postgres
CORE_DB_PORT=5432
CORE_DB_USERNAME=crypto_user
CORE_DB_PASSWORD=CHANGE_ME_64_CHAR_RANDOM
CORE_DB_NAME=crypto_trading_platform

# Market read source: postgres | redis | timescale
MARKET_READ_SOURCE=postgres

# ─── Event Outbox ──────────────────────────────────────────────────────────────
EVENT_OUTBOX_ENABLED=true
EVENT_SCHEMA_FORMAT=json
EVENT_PUBLISHER_DRIVER=bullmq
EVENT_OUTBOX_MAX_ATTEMPTS=5
EVENT_OUTBOX_RETRY_BASE_MS=1000

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_64_CHAR_RANDOM
REDIS_DB=0

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a strong random 64-char hex secret — never use default values
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_EXPIRATION=24h

# ─── Matching Engine ───────────────────────────────────────────────────────────
# MATCHING_ENGINE=ts
# TICKER_SOURCE=nestjs
# PUBLIC_WS_SOURCE=nestjs

# ─── Exchange (Binance Mainnet) ────────────────────────────────────────────────
TRADING_ENVIRONMENT=mainnet
EXCHANGE_MODE=binance
BINANCE_TESTNET_ENABLED=false
BINANCE_MAINNET_API_KEY=CHANGE_ME
BINANCE_MAINNET_API_SECRET=CHANGE_ME
BINANCE_MAINNET_BASE_URL=https://fapi.binance.com

# ─── On-chain (Production) ──────────────────────────────────────────────────────
ONCHAIN_OPERATOR_MODE=production
TRON_GRID_API_KEY=CHANGE_ME

# ─── Wallet Encryption (AES-256-GCM) ───────────────────────────────────────────
# IMPORTANT: Replace with a strong 32-byte hex key (64 hex chars) — never use default values
# Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=CHANGE_ME_64_CHAR_HEX

# IMPORTANT: Replace with a strong 32-byte hex key (64 hex chars) — never use default values
# Generate with: openssl rand -hex 32
BINANCE_CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_64_CHAR_HEX

# ─── PayOS ───────────────────────────────────────────────────────────────────
PAYOS_CLIENT_ID=CHANGE_ME
PAYOS_API_KEY=CHANGE_ME
PAYOS_CHECKSUM_KEY=CHANGE_ME
PAYOS_RETURN_URL=https://yourdomain.com/success
PAYOS_CANCEL_URL=https://yourdomain.com/cancel
PAYOS_DEPOSIT_CURRENCY_SYMBOL=USDT
PAYOS_FIAT_SYMBOL=VND
PAYOS_FIAT_TO_QUOTE_RATE=0.00004
PAYOS_FX_SPREAD_BPS=0

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=CHANGE_ME_APP_PASSWORD
SMTP_FROM=Crypto Trading <noreply@yourdomain.com>

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Path to firebase service account JSON file (should be outside repo)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Monitoring ───────────────────────────────────────────────────────────────
# Grafana admin password
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Telegram alert configuration
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
