NODE_ENV=production
PORT=3000

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=crypto_user
DB_PASSWORD=3038a6b0ee1f1bc62c8e9de7f9e9adc1
DB_NAME=crypto_trading_platform

# Core DB (PostgreSQL source of truth)
CORE_DB_SOURCE=postgres
CORE_DB_TYPE=postgres
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=5432
CORE_DB_USERNAME=crypto_user
CORE_DB_PASSWORD=3038a6b0ee1f1bc62c8e9de7f9e9adc1
CORE_DB_NAME=crypto_trading_platform

# Optional read/analytics switches
MARKET_READ_SOURCE=postgres
MARKET_TS_ENABLED=false
MARKET_TS_DRIVER=postgres
MARKET_TS_TIMESCALE_ENABLED=false
MARKET_TS_RETENTION_ENABLED=false
MARKET_TS_RETENTION_DAYS=30
MARKET_TS_COMPRESSION_ENABLED=false
MARKET_TS_COMPRESS_AFTER_DAYS=7
MARKET_TS_HOST=127.0.0.1
MARKET_TS_PORT=5433
MARKET_TS_USERNAME=crypto_user
MARKET_TS_PASSWORD=3038a6b0ee1f1bc62c8e9de7f9e9adc1
MARKET_TS_DB=crypto_trading_platform

ANALYTICS_ENABLED=false
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# Event outbox - core settings (thresholds được quản lý qua DB runtime settings)
EVENT_OUTBOX_ENABLED=true
EVENT_SCHEMA_FORMAT=json
EVENT_PUBLISHER_DRIVER=noop
EVENT_OUTBOX_MAX_ATTEMPTS=5
EVENT_OUTBOX_RETRY_BASE_MS=1000

# Outbox thresholds - quản lý qua /system-configs/runtime (DB). Uncomment để override.
# EVENT_OUTBOX_ALERT_MAX_DEAD_LETTER_ROWS=0
# EVENT_OUTBOX_ALERT_MAX_OLDEST_UNPUBLISHED_AGE_SECONDS=300
# EVENT_OUTBOX_ALERT_MAX_OLDEST_DEAD_LETTER_AGE_SECONDS=60
# EVENT_OUTBOX_ALERT_CRITICAL_MAX_DEAD_LETTER_ROWS=10
# EVENT_OUTBOX_ALERT_CRITICAL_MAX_OLDEST_UNPUBLISHED_AGE_SECONDS=1800
# EVENT_OUTBOX_ALERT_CRITICAL_MAX_OLDEST_DEAD_LETTER_AGE_SECONDS=600
# EVENT_OUTBOX_ALERT_AUTOMATION_ENABLED=true
# EVENT_OUTBOX_ALERTS_CHANNEL=outbox:alerts

# Kafka (optional)
KAFKA_BROKERS=
KAFKA_CLIENT_ID=crypto-trading-backend-outbox
KAFKA_TOPIC_PREFIX=

# Feature flags - quản lý qua /system-configs/runtime (DB). Uncomment để override.
# TICKER_SOURCE=nestjs
# MATCHING_ENGINE=ts
# MATCHING_GO_CANARY_PAIRS=
# PUBLIC_WS_SOURCE=nestjs
# GO_AGGREGATOR_TICKER_CHANNEL=trading:external:ticker
# GO_AGGREGATOR_OHLC_CHANNEL=trading:external:ohlc
# MATCHING_SHADOW_MONITOR_PAIRS=
# MATCHING_SHADOW_ALERT_MIN_MATCH_RATE_PERCENT=99.9
# MATCHING_SHADOW_ALERT_MAX_UNMATCHED_RUNS=0
# GO_ROLLOUT_WINDOW_HOURS=24
# GO_ROLLOUT_MAX_PUBLIC_WS_DRIFT_PAIRS=0
# GO_ROLLOUT_MIN_PUBLIC_WS_COMPARED_PAIRS=1
# GO_ROLLOUT_ROLLBACK_DRILL_MAX_AGE_HOURS=72

# Market read model alert thresholds - quản lý qua /system-configs/runtime (DB)
# MARKET_READ_MODEL_ALERT_MAX_LAG_SECONDS=300
# MARKET_READ_MODEL_ALERT_CRITICAL_MAX_LAG_SECONDS=900

# Market maker defaults - quản lý qua /system-configs/runtime (DB)
# MM_DEFAULT_SPREAD_BPS=10
# MM_DEFAULT_SPREAD_ALERT_THRESHOLD_BPS=20
# MM_DEFAULT_ORDER_AMOUNT=0.001

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=426361bcd24b8f76e66b4a748c155d87
REDIS_DB=0
# MATCHING_BOOK_FULL_REFRESH=true

# JWT
JWT_SECRET=f62626af6d4995c1435f7df916e57252
JWT_EXPIRATION=24h

# Binance Mainnet
TRADING_ENVIRONMENT=mainnet
EXCHANGE_MODE=binance
BINANCE_TESTNET_ENABLED=false
BINANCE_MAINNET_API_KEY=your_mainnet_api_key
BINANCE_MAINNET_API_SECRET=your_mainnet_api_secret
BINANCE_MAINNET_BASE_URL=https://fapi.binance.com

# Wallet encryption (treasury / payment config payloads)
WALLET_ENCRYPTION_KEY=your_32_byte_hex_key

# WalletConnect / Reown
WALLETCONNECT_PROJECT_ID=your_project_id
REOWN_PROJECT_ID=your_project_id
WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.com
WALLETCONNECT_WEBHOOK_SECRET=your_webhook_secret

# On-chain: production = mainnets; sandbox = testnets (defaults auto-filled)
ONCHAIN_OPERATOR_MODE=production

# TronGrid API key (optional - public RPC fallback nếu không có)
TRON_GRID_API_KEY=your_trongrid_api_key

# --- PayOS (.env fallback) ---
# DB có cấu hình PayOS active thì ưu tiên DB
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=https://yourdomain.com/success
PAYOS_CANCEL_URL=https://yourdomain.com/cancel
PAYOS_DEPOSIT_CURRENCY_SYMBOL=USDT
PAYOS_FIAT_SYMBOL=VND
PAYOS_FIAT_TO_QUOTE_RATE=0.00004
PAYOS_FX_SPREAD_BPS=0

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_AVATAR_FOLDER=avatars

# SMTP for 2FA OTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=Crypto Trading <noreply@yourdomain.com>

# Firebase Admin SDK (for FCM)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
