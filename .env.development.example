NODE_ENV=development
PORT=3000

# ─── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL source of truth (mirrors DB_* above for explicit clarity)
CORE_DB_SOURCE=postgres
CORE_DB_TYPE=postgres
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=5432
CORE_DB_USERNAME=crypto_user
CORE_DB_PASSWORD=3038a6b0ee1f1bc62c8e9de7f9e9adc1
CORE_DB_NAME=crypto_trading_platform

# TimescaleDB (optional — enable MARKET_TS_ENABLED=true when TimescaleDB is available)
MARKET_TS_ENABLED=true
MARKET_TS_DRIVER=postgres
MARKET_TS_HOST=127.0.0.1
MARKET_TS_PORT=5433
MARKET_TS_USERNAME=crypto_user
MARKET_TS_PASSWORD=3038a6b0ee1f1bc62c8e9de7f9e9adc1
MARKET_TS_DB=crypto_trading_platform
MARKET_TS_TIMESCALE_ENABLED=true
MARKET_TS_RETENTION_ENABLED=false
MARKET_TS_RETENTION_DAYS=30
MARKET_TS_COMPRESSION_ENABLED=false
MARKET_TS_COMPRESS_AFTER_DAYS=7

# Market read source: postgres | redis | timescale
MARKET_READ_SOURCE=postgres

# ─── Analytics / ClickHouse ───────────────────────────────────────────────────
# ANALYTICS_ENABLED=true → enables ClickHouse audit sink (Phase 5c)
ANALYTICS_ENABLED=true
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# ─── Event Outbox ─────────────────────────────────────────────────────────────
EVENT_OUTBOX_ENABLED=true
EVENT_SCHEMA_FORMAT=json
# Driver: noop | kafka | redis | bullmq
EVENT_PUBLISHER_DRIVER=kafka
EVENT_OUTBOX_MAX_ATTEMPTS=5
EVENT_OUTBOX_RETRY_BASE_MS=1000

# ─── Kafka ───────────────────────────────────────────────────────────────────
# Silence KafkaJS v2.0 partitioner change warning
KAFKAJS_NO_PARTITIONER_WARNING=1
# Leave KAFKA_BROKERS empty when EVENT_PUBLISHER_DRIVER=noop
# When EVENT_PUBLISHER_DRIVER=kafka → set KAFKA_BROKERS and KAFKA_TOPIC_PREFIX
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=crypto-trading-backend-outbox
KAFKA_TOPIC_PREFIX=crypto-trading
# Phase 6: Kafka DLQ — publish dead-lettered events to a dedicated DLQ topic
KAFKA_DLQ_TOPIC_ENABLED=true
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_CONNECTION_TIMEOUT_MS=10000
# KRaft cluster ID — generate once: powershell -Command "[Convert]::ToBase64String(([Guid]::NewGuid().ToByteArray())).TrimEnd('=')"
KAFKA_CLUSTER_ID=

# Kafka consumer (Phase 5d): enable only when Kafka brokers are available
# and DB-based projection consumer is being migrated to Kafka-based consumers
KAFKA_CONSUMERS_ENABLED=true
KAFKA_CONSUMER_GROUP_PREFIX=crypto-trading

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=426361bcd24b8f76e66b4a748c155d87
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=f62626af6d4995c1435f7df916e57252
JWT_EXPIRATION=24h

# ─── Matching Engine ─────────────────────────────────────────────────────────
# Type: ts | go
# ts → NestJS matching engine (default, production-ready)
# go → Go shadow matching service (Phase 6-8, requires go-shadow-matching service)
# TICKER_SOURCE: nestjs | redis | go (Phase 6-8)
# PUBLIC_WS_SOURCE: nestjs | redis | go (Phase 6-8)
# All matching config is also manageable via /system-configs/runtime (DB)
# MATCHING_ENGINE=ts
# TICKER_SOURCE=nestjs
# PUBLIC_WS_SOURCE=nestjs
# MATCHING_GO_CANARY_PAIRS=
# GO_AGGREGATOR_TICKER_CHANNEL=trading:external:ticker
# GO_AGGREGATOR_OHLC_CHANNEL=trading:external:ohlc
# MATCHING_SHADOW_MONITOR_PAIRS=
# MATCHING_SHADOW_ALERT_MIN_MATCH_RATE_PERCENT=99.9
# MATCHING_SHADOW_ALERT_MAX_UNMATCHED_RUNS=0
# GO_ROLLOUT_WINDOW_HOURS=24
# GO_ROLLOUT_MAX_PUBLIC_WS_DRIFT_PAIRS=0
# GO_ROLLOUT_MIN_PUBLIC_WS_COMPARED_PAIRS=1
# GO_ROLLOUT_ROLLBACK_DRILL_MAX_AGE_HOURS=72

# ─── Exchange ─────────────────────────────────────────────────────────────────
TRADING_ENVIRONMENT=testnet
EXCHANGE_MODE=binance
BINANCE_TESTNET_ENABLED=true
BINANCE_TESTNET_API_KEY=ky0yxPNEnwj8nOViEvFdzmSfiGU13jIvFnYfnl6uDJaui8zidsBVuodQ2OOgwmN6
BINANCE_TESTNET_API_SECRET=0ZPwyX9mP8Utoj3buuzpLMqEZsKgvEaVdtuA6ABdCbSQEsJU6IR2l9MkTwMRSS0E
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision

# ─── On-chain ─────────────────────────────────────────────────────────────────
