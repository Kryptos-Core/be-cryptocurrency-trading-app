NODE_ENV=development
PORT=3000

# ─── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL source of truth (mirrors DB_* above for explicit clarity)
CORE_DB_SOURCE=postgres
CORE_DB_TYPE=postgres
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=5432
CORE_DB_USERNAME=crypto_user
CORE_DB_PASSWORD=3038a6b0ee1f1bc62c8e9de7f9e9adc1
CORE_DB_NAME=crypto_trading_platform

# Market read source: postgres | redis | timescale
MARKET_READ_SOURCE=postgres

# ─── Event Outbox ─────────────────────────────────────────────────────────────
EVENT_OUTBOX_ENABLED=true
EVENT_SCHEMA_FORMAT=json
# Driver: noop | kafka | redis | bullmq
EVENT_PUBLISHER_DRIVER=noop
EVENT_OUTBOX_MAX_ATTEMPTS=5
EVENT_OUTBOX_RETRY_BASE_MS=1000
# Bounded DLQ retry cap — once a dead-lettered row is reset this many times it is
# excluded from the auto-retry sweep and requires manual replay via /admin/outbox.
EVENT_OUTBOX_DLQ_MAX_RETRIES=3
# Per-flush dead-letter retry cap (number of candidate rows the relay attempts
# to reset on each successful flush cycle).
EVENT_OUTBOX_DEAD_LETTER_RETRY_PER_FLUSH=3

# ─── Kafka ───────────────────────────────────────────────────────────────────
# Uncomment and set EVENT_PUBLISHER_DRIVER=kafka when Kafka container is running
# docker compose -f docker-compose.infrastructure.development.yml --profile kafka up -d
# KAFKAJS_NO_PARTITIONER_WARNING=1
# KAFKA_BROKERS=localhost:29092
# KAFKA_CLIENT_ID=crypto-trading-backend-outbox
# KAFKA_TOPIC_PREFIX=crypto-trading
# KAFKA_CLUSTER_ID=generate_once
# KAFKA_DLQ_TOPIC_ENABLED=true
# KAFKA_CONSUMERS_ENABLED=true
# KAFKA_CONSUMER_GROUP_PREFIX=crypto-trading
# Idempotent producer + acks=all (kafkajs forces acks=-1 internally when
# idempotent=true). maxInFlightRequests is capped at 5 by kafkajs for idempotent.
# KAFKA_PRODUCER_IDEMPOTENT=true
# KAFKA_PRODUCER_MAX_IN_FLIGHT=1

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=426361bcd24b8f76e66b4a748c155d87
REDIS_DB=0

# ─── TimescaleDB (Market read store) ──────────────────────────────────────────
MARKET_TS_HOST=127.0.0.1
MARKET_TS_PORT=5433
MARKET_TS_USERNAME=market_user
MARKET_TS_PASSWORD=market_ts_password_dev
MARKET_TS_DB=market_analytics

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=f62626af6d4995c1435f7df916e57252
JWT_EXPIRATION=24h

# ─── Matching Engine ─────────────────────────────────────────────────────────
# Type: ts | go
# ts → NestJS matching engine (default, production-ready)
# go → Go shadow matching service (Phase 6-8, requires go-shadow-matching service)
# TICKER_SOURCE: nestjs | redis | go (Phase 6-8)
# PUBLIC_WS_SOURCE: nestjs | redis | go (Phase 6-8)
# All matching config is also manageable via /system-configs/runtime (DB)
# MATCHING_ENGINE=ts
# TICKER_SOURCE=nestjs
# PUBLIC_WS_SOURCE=nestjs
# MATCHING_GO_CANARY_PAIRS=
# GO_AGGREGATOR_TICKER_CHANNEL=trading:external:ticker
# GO_AGGREGATOR_OHLC_CHANNEL=trading:external:ohlc
# MATCHING_SHADOW_MONITOR_PAIRS=
# MATCHING_SHADOW_ALERT_MIN_MATCH_RATE_PERCENT=99.9
# MATCHING_SHADOW_ALERT_MAX_UNMATCHED_RUNS=0
# GO_ROLLOUT_WINDOW_HOURS=24
# GO_ROLLOUT_MAX_PUBLIC_WS_DRIFT_PAIRS=0
# GO_ROLLOUT_MIN_PUBLIC_WS_COMPARED_PAIRS=1
# GO_ROLLOUT_ROLLBACK_DRILL_MAX_AGE_HOURS=72

