# Legacy fallback env file consumed by scripts/run-treasury-daily.ps1
# Preferred source is DB config managed in Admin UI -> Treasury E2E Config.
# Use this file only for local override, bootstrap, or when TREASURY_E2E_CONFIG_SOURCE=env.

# Config source
TREASURY_E2E_CONFIG_SOURCE=db
TREASURY_E2E_CONFIG_ENV=development

# API base URL
E2E_API_BASE_URL=http://127.0.0.1:3000

# Tokens / identities
E2E_BEARER_TOKEN_TRADER=
E2E_BEARER_TOKEN_RISK=

# Withdrawal test inputs
E2E_CHAIN=BSC_CHAPEL
E2E_LINKED_WALLET_ID=
E2E_WITHDRAW_AMOUNT_AUTO=0.01
E2E_WITHDRAW_AMOUNT_MANUAL=1.0

# Optional deposit E2E
E2E_DEPOSIT_TX_HASH=
E2E_DEPOSIT_AMOUNT=

# Dev mode defaults used by scheduler runner
TREASURY_E2E_ALLOW_SKIP=true
TREASURY_HEALTH_FAIL_ON_CRITICAL=false

# Optional health thresholds (fallback only when DB config is absent)
TREASURY_ALERT_STALE_MANUAL_MINUTES=15
TREASURY_ALERT_STALE_CONFIRMING_MINUTES=30
TREASURY_ALERT_FAILED_WITHDRAWALS_24H=10
TREASURY_RECONCILE_PAIR_LIMIT=100

# If you want strict behavior in CI/staging:
# TREASURY_E2E_CONFIG_SOURCE=db
# TREASURY_E2E_ALLOW_SKIP=false
# TREASURY_HEALTH_FAIL_ON_CRITICAL=true
