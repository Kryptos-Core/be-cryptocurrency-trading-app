# Optional env file consumed by scripts/run-treasury-daily.ps1
# Copy to scripts/treasury-e2e.env and fill real values when you want full E2E (non-skip).

# API base URL
E2E_API_BASE_URL=http://127.0.0.1:3000

# Tokens / identities
E2E_BEARER_TOKEN_TRADER=
E2E_BEARER_TOKEN_RISK=

# Withdrawal test inputs
E2E_CHAIN=BSC_CHAPEL
E2E_LINKED_WALLET_ID=
E2E_WITHDRAW_AMOUNT_AUTO=0.01
E2E_WITHDRAW_AMOUNT_MANUAL=1.0

# Optional deposit E2E
E2E_DEPOSIT_TX_HASH=
E2E_DEPOSIT_AMOUNT=

# Dev mode defaults used by scheduler runner
TREASURY_E2E_ALLOW_SKIP=true
TREASURY_HEALTH_FAIL_ON_CRITICAL=false

# If you want strict behavior in CI/staging:
# TREASURY_E2E_ALLOW_SKIP=false
# TREASURY_HEALTH_FAIL_ON_CRITICAL=true
