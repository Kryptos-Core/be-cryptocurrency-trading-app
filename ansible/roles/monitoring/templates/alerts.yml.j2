# Prometheus Alert Rules for Crypto Trading Platform
{% raw %}

groups:
  - name: crypto-trading-backend
    interval: 30s
    rules:
      # Backend Availability
      - alert: BackendDown
        expr: up{job="crypto-backend"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Backend API target {{ $labels.instance }} is down"
          description: "Prometheus cannot scrape the crypto-backend target for more than 1 minute. Job={{ $labels.job }}, instance={{ $labels.instance }}."
          impact: "API requests, order placement, auth, and websocket-dependent flows may be unavailable."
          action: "Check backend container health/logs, recent deploys, env vars, DB/Redis connectivity, and restart policy."

      # High Error Rate
      - alert: HighErrorRate
        expr: |
          (
            sum(rate(http_requests_total{job="crypto-backend", status=~"5.."}[5m]))
            /
            sum(rate(http_requests_total{job="crypto-backend"}[5m]))
          ) > 0.05
          and
          sum(rate(http_requests_total{job="crypto-backend"}[5m])) > 1
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Backend 5xx error rate is above 5%"
          description: "More than 5% of crypto-backend HTTP requests are returning 5xx over 5 minutes while traffic is above 1 req/s."
          impact: "Users may see failed API calls, failed trading operations, or degraded integrations."
          action: "Inspect backend logs by route/status, recent releases, downstream DB/Redis latency, and exception traces."

      # High Latency
      - alert: HighLatency
        expr: |
          histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job="crypto-backend"}[5m])) by (le))
          > 2
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Backend p95 latency is above 2 seconds"
          description: "95th percentile HTTP request duration for crypto-backend is above 2 seconds for 5 minutes."
          impact: "API, trading screens, and bots may experience slow responses or timeouts."
          action: "Check slow endpoints, DB queries, Redis latency, CPU saturation, and external RPC/provider calls."

      # High Memory Usage
      - alert: HighMemoryUsage
        expr: |
          (container_memory_usage_bytes{job="crypto-backend", container="app"}
          / container_spec_memory_limit_bytes{job="crypto-backend", container="app"}) > 0.85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Backend container memory usage is above 85%"
          description: "Container app memory usage is above 85% of its configured limit for 5 minutes. Instance={{ $labels.instance }}."
          impact: "The backend container is at risk of OOM kill, restarts, and request failures."
          action: "Check memory leaks, heap usage, worker queues, large queries, and container restart/OOM events."

      # High CPU Usage
      - alert: HighCPUUsage
        expr: |
          (rate(container_cpu_usage_seconds_total{job="crypto-backend", container="app"}[5m])
          / container_spec_cpu_quota{job="crypto-backend", container="app"}) * 100) > 80
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Backend container CPU usage is above 80%"
          description: "Container app CPU usage is above 80% for more than 5 minutes. Instance={{ $labels.instance }}."
          impact: "API latency, websocket updates, and background jobs may slow down or time out."
          action: "Inspect CPU-heavy endpoints/jobs, event loop lag, traffic spikes, and container CPU limits."

  - name: crypto-trading-database
    interval: 30s
    rules:
      # Database Down
      - alert: DatabaseDown
        expr: |
          up{job="postgres-exporter"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "PostgreSQL exporter target {{ $labels.instance }} is down"
          description: "Prometheus cannot scrape postgres-exporter for more than 1 minute."
          impact: "Database visibility is lost and the app may fail if PostgreSQL itself is unavailable."
          action: "Check PostgreSQL container/service status, exporter DSN, network, credentials, and database logs."

      # Database Connection Pool Exhausted
      - alert: DatabaseConnectionsHigh
        expr: |
          pg_stat_activity_count / pg_settings_max_connections > 0.8
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "PostgreSQL connection usage is above 80%"
          description: "Active PostgreSQL connections are above 80% of max_connections for 5 minutes."
          impact: "New API requests and jobs may fail to acquire database connections."
          action: "Inspect connection leaks, pool sizes, long-running sessions, PgBouncer settings, and stuck transactions."

      # Slow Queries
      - alert: SlowQueries
        expr: |
          pg_stat_activity_max_tx_duration > 30
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "PostgreSQL has queries running longer than 30 seconds"
          description: "At least one transaction/query has been active for more than 30 seconds for 5 minutes."
          impact: "Slow queries can block writes, increase latency, and exhaust connection pools."
          action: "Review pg_stat_activity, query plans, locks, missing indexes, and recent migrations/releases."

  - name: crypto-trading-redis
    interval: 30s
    rules:
      # Redis Down
      - alert: RedisDown
        expr: |
          up{job="redis"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Redis exporter target {{ $labels.instance }} is down"
          description: "Prometheus cannot scrape Redis metrics for more than 1 minute."
          impact: "Cache, queues, sessions, rate limits, or websocket fanout may be degraded if Redis is unavailable."
          action: "Check Redis container/service status, exporter connectivity, Redis logs, memory, and restart events."

      # Redis Memory High
      - alert: RedisMemoryHigh
        expr: |
          (redis_memory_used_bytes / redis_memory_max_bytes) > 0.8
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Redis memory usage is above 80%"
          description: "Redis used memory is above 80% of configured maxmemory for 5 minutes."
          impact: "Redis may evict keys, reject writes, slow queues, or destabilize realtime features."
          action: "Inspect key cardinality, queue backlog, eviction policy, maxmemory, and application cache growth."

  - name: infrastructure
    interval: 30s
    rules:
      # Host Down
      - alert: HostDown
        expr: |
          up{job="node-exporter"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Server exporter target {{ $labels.instance }} is down"
          description: "Prometheus cannot scrape node-exporter for more than 1 minute. Job={{ $labels.job }}, instance={{ $labels.instance }}."
          impact: "Host metrics are unavailable; the server may be down, unreachable, or node-exporter may have stopped."
          action: "Check VM reachability, node-exporter container/service status, firewall/security group, and Docker daemon health."

      # Disk Space Low
      - alert: DiskSpaceLow
        expr: |
          (
            node_filesystem_avail_bytes{mountpoint="/", fstype!~"tmpfs|overlay|squashfs|ramfs", device!~"rootfs"}
            /
            node_filesystem_size_bytes{mountpoint="/", fstype!~"tmpfs|overlay|squashfs|ramfs", device!~"rootfs"}
          ) < 0.1
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Root disk free space is below 10% on {{ $labels.instance }}"
          description: "The root filesystem has less than 10% free space for 5 minutes. Mount={{ $labels.mountpoint }}, device={{ $labels.device }}."
          impact: "Database writes, logs, Docker pulls, and application persistence can fail when disk fills up."
          action: "Clean old Docker images/containers/logs, rotate large logs, verify database volume growth, or expand disk."

      # Load Average High
      - alert: LoadAverageHigh
        expr: |
          node_load1 / count(node_cpu_seconds_total{mode="idle"}) > 0.8
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Server load average is high on {{ $labels.instance }}"
          description: "1-minute load average is above 80% of CPU count for 10 minutes."
          impact: "Containers may respond slowly; API latency, DB queries, and background workers can degrade."
          action: "Inspect top processes, container CPU usage, noisy jobs, DB load, and recent traffic spikes."
{% endraw %}
