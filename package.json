{
  "name": "crypto-trading-backend",
  "version": "1.0.0",
  "description": "NestJS Cryptocurrency Trading Platform Backend",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "biome format --write ./src ./scripts",
    "format:check": "biome format ./src ./scripts",
    "lint": "biome lint ./src ./scripts",
    "lint:fix": "biome check --write ./src ./scripts",
    "lint:boundaries": "node scripts/check-module-boundaries.mjs",
    "lint:uow": "node scripts/check-uow-policy.mjs",
    "check": "biome check ./src ./scripts",
    "check:fix": "biome check --write ./src ./scripts",
    "start": "cross-env NODE_ENV=development nest start",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:staging": "cross-env NODE_ENV=staging nest start",
    "dev:staging": "cross-env NODE_ENV=staging nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "typeorm": "node -r tsconfig-paths/register ./node_modules/typeorm/cli-ts-node-commonjs.js",
    "migration:generate": "cross-env NODE_ENV=development npm run typeorm -- migration:generate -d src/config/data-source.ts",
    "migration:create": "cross-env NODE_ENV=development npm run typeorm -- migration:create",
    "migration:run": "cross-env NODE_ENV=development npm run typeorm -- migration:run -d src/config/data-source.ts",
    "migration:revert": "cross-env NODE_ENV=development npm run typeorm -- migration:revert -d src/config/data-source.ts",
    "migration:show": "cross-env NODE_ENV=development npm run typeorm -- migration:show -d src/config/data-source.ts",
    "db:seed": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/seed/run-seed.ts",
    "db:clean": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/seed/run-db-clean.ts",
    "db:reset": "npm run db:seed",
    "docker:infra:up": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development up -d",
    "docker:infra:up:redis": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development up -d redis",
    "docker:infra:up:postgres": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development up -d postgres",
    "docker:infra:up:timescale": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development --profile timescale up -d timescaledb",
    "docker:infra:down": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development down",
    "docker:infra:logs": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development logs -f",
    "treasury:e2e": "ts-node -r tsconfig-paths/register scripts/daily-testnet-deposit-withdraw-e2e.ts",
    "treasury:health": "ts-node -r tsconfig-paths/register scripts/daily-treasury-health-check.ts",
    "treasury:daily": "npm run treasury:e2e && npm run treasury:health",
    "treasury:schedule:register": "powershell -ExecutionPolicy Bypass -File scripts/register-treasury-daily-task.ps1",
    "treasury:schedule:unregister": "powershell -ExecutionPolicy Bypass -File scripts/unregister-treasury-daily-task.ps1",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "postman:build": "node postman/build-collection.mjs"
  },
  "dependencies": {
    "@bull-board/express": "^7.0.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^10.2.10",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.10",
    "@nestjs/cqrs": "^10.2.8",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.2.10",
    "@nestjs/platform-socket.io": "^10.2.10",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.2.10",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@payos/node": "^2.0.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "@solana/web3.js": "^1.98.4",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@walletconnect/core": "^2.23.9",
    "@walletconnect/sign-client": "^2.23.9",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "bcryptjs": "^3.0.2",
    "bs58": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^2.9.0",
    "decimal.js": "^10.6.0",
    "ethers": "^6.16.0",
    "firebase-admin": "^13.7.0",
    "ioredis": "^5.9.1",
    "kafkajs": "^2.2.4",
    "nodemailer": "^8.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "piscina": "^5.1.4",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "tronweb": "^6.2.2",
    "tweetnacl": "^1.0.3",
    "typeorm": "^0.3.17",
    "uuidv7": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.2",
    "@nestjs/testing": "^10.2.10",
    "@types/bs58": "^4.0.4",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.9.0",
    "@types/ws": "^8.5.10",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2",
    "webpack": "^5.104.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage"
  }
}


