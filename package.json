{
  "name": "crypto-trading-backend",
  "version": "1.0.0",
  "description": "NestJS Cryptocurrency Trading Platform Backend",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "start:staging": "cross-env NODE_ENV=staging nest start",
    "lint": "biome lint ./src ./scripts",
    "lint:fix": "biome check --write ./src ./scripts",
    "format": "biome format --write ./src ./scripts",
    "format:check": "biome format ./src ./scripts",
    "lint:boundaries": "node scripts/check-module-boundaries.mjs",
    "lint:uow": "node scripts/check-uow-policy.mjs",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "db:migrate": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/seed/run-migrations.ts",
    "db:migrate:prod": "node -r tsconfig-paths/register dist/seed/run-migrations.js",
    "db:migrate:generate": "cross-env NODE_ENV=development node -r tsconfig-paths/register ./node_modules/typeorm/cli-ts-node-commonjs.js -- migration:generate -d src/config/data-source.ts --verbose",
    "db:migrate:create": "cross-env NODE_ENV=development node -r tsconfig-paths/register ./node_modules/typeorm/cli-ts-node-commonjs.js -- migration:create",
    "db:migrate:revert": "cross-env NODE_ENV=development node -r tsconfig-paths/register ./node_modules/typeorm/cli-ts-node-commonjs.js -- migration:revert -d src/config/data-source.ts --verbose",
    "db:migrate:show": "cross-env NODE_ENV=development node -r tsconfig-paths/register ./node_modules/typeorm/cli-ts-node-commonjs.js -- migration:show -d src/config/data-source.ts --verbose",
    "db:seed": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/seed/run-seed.ts",
    "db:seed:prod": "cross-env NODE_ENV=production CORE_DB_HOST=127.0.0.1 ts-node -r tsconfig-paths/register src/seed/run-seed.ts",
    "db:clean": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/seed/run-db-clean.ts",
    "db:clean:prod": "cross-env NODE_ENV=production CORE_DB_HOST=127.0.0.1 ts-node -r tsconfig-paths/register src/seed/run-db-clean.ts",
    "db:outbox:reset": "docker exec crypto_trading_postgres psql -U crypto_user -d crypto_trading_platform -c \"UPDATE integration_outbox SET dead_lettered_at = NULL, publish_attempts = 0, next_retry_at = NULL WHERE dead_lettered_at IS NOT NULL;\"",
    "db:migrate:ch": "docker exec -i crypto_trading_clickhouse clickhouse-client --host 127.0.0.1 --port 9000 --query \"$(cat scripts/docker/clickhouse-init.sql)\"",
    "db:migrate:ch:status": "docker exec crypto_trading_clickhouse clickhouse-client --host localhost --port 9000 --query \"SHOW TABLES FROM analytics FORMAT PrettyCompact\"",
    "clickhouse:tables:list": "docker exec crypto_trading_clickhouse clickhouse-client --host localhost --port 9000 --query \"SHOW TABLES FROM analytics FORMAT PrettyCompact\"",
    "docker:infra:up": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development up -d",
    "docker:infra:up:full": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development --profile kafka --profile clickhouse --profile timescale up -d",
    "docker:infra:down": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development down",
    "docker:infra:logs": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development logs -f",
    "docker:infra:health": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development ps --format \"table {{.Name}}\\t{{.Health}}\\t{{.Status}}\"",
    "docker:kafka:cleanup": "node scripts/docker/cleanup-kafka-volumes.js",
    "kafka:topics:create": "node scripts/create-kafka-topics.js",
    "kafka:topics:list": "docker exec crypto_trading_kafka kafka-topics --bootstrap-server localhost:9092 --list",
    "clickhouse:init:run": "docker compose -f docker-compose.infrastructure.yml --env-file .env.development --profile clickhouse run --rm clickhouse-init",
    "treasury:e2e": "ts-node -r tsconfig-paths/register scripts/daily-testnet-deposit-withdraw-e2e.ts",
    "treasury:health": "ts-node -r tsconfig-paths/register scripts/daily-treasury-health-check.ts",
    "treasury:daily": "npm run treasury:e2e && npm run treasury:health",
    "treasury:schedule:register": "powershell -ExecutionPolicy Bypass -File scripts/register-treasury-daily-task.ps1",
    "treasury:schedule:unregister": "powershell -ExecutionPolicy Bypass -File scripts/unregister-treasury-daily-task.ps1",
    "deploy:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d",
    "deploy:prod:build": "docker compose -f docker-compose.prod.yml --env-file .env.production build --pull",
    "deploy:prod:start": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "deploy:prod:stop": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "deploy:prod:restart": "npm run deploy:prod:stop && npm run deploy:prod:start",
    "deploy:prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f",
    "deploy:prod:status": "docker compose -f docker-compose.prod.yml --env-file .env.production ps",
    "deploy:prod:migrate": "docker compose -f docker-compose.prod.yml --env-file .env.production exec app npm run db:migrate:prod",
    "deploy:prod:migrate:ch": "docker compose -f docker-compose.prod.yml --env-file .env.production exec clickhouse clickhouse-client --host 127.0.0.1 --port 9000 --query \"$(cat scripts/docker/clickhouse-init.sql)\"",
    "deploy:prod:full": "npm run deploy:prod:start && npm run deploy:prod:migrate && npm run deploy:prod:migrate:ch"
  },
  "dependencies": {
    "@bull-board/express": "^7.0.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^10.2.10",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.10",
    "@nestjs/cqrs": "^10.2.8",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.2.10",
    "@nestjs/platform-socket.io": "^10.2.10",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.2.10",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@payos/node": "^2.0.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "@solana/web3.js": "^1.98.4",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@walletconnect/core": "^2.23.9",
    "@walletconnect/sign-client": "^2.23.9",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "bcryptjs": "^3.0.2",
    "bs58": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^2.9.0",
    "decimal.js": "^10.6.0",
    "ethers": "^6.16.0",
    "firebase-admin": "^13.7.0",
    "ioredis": "^5.9.1",
    "kafkajs": "^2.2.4",
    "nodemailer": "^8.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "piscina": "^5.1.4",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "tronweb": "^6.2.2",
    "tweetnacl": "^1.0.3",
    "typeorm": "^0.3.17",
    "uuidv7": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.2",
    "@nestjs/testing": "^10.2.10",
    "@types/bs58": "^4.0.4",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.9.0",
    "@types/ws": "^8.5.10",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2",
    "webpack": "^5.104.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage"
  }
}
